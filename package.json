{
  "name": "card-game-score-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node -e \"const fs = require('fs'); fs.copyFileSync('src/assets/index.html', 'build/index.html'); fs.copyFileSync('src/assets/styles.css', 'build/styles.css');\"",
    "dev": "tsc --watch --project tsconfig.build.json & npx http-server ./build -p 8080 -c-1",
    "lint": "eslint \"**/*.{ts,js}\"",
    "test": "jest --coverage",
    "test:no-coverage": "jest",
    "start": "npm run build && npm run lint && npx http-server ./build -p 8080 -c-1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.12"
  },
  "overrides": {
    "test-exclude": "^8.0.0",
    "glob": "^13.0.0",
    "jsdom": "^29.0.0",
    "js-yaml": "^4.2.0"
  }
}
